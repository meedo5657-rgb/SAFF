rules_version = '2';

// Firebase Storage rules for the weekly volleyball app (volley.html).
// Uploaded video clips live under volley/videos/<videoId>/<filename>.
// Copy these into: Firebase Console > Storage > Rules  (then Publish).
service firebase.storage {
  match /b/{bucket}/o {

    // Volleyball training videos: any signed-in (anonymous) user may
    // read and upload. Cap size at 200MB and require a video/* mime type.
    match /volley/videos/{videoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }

    // Everything else: locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
