{
  "rules": {
    "volley": {
      ".read": "auth != null",

      "users": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          }
        }
      },

      "players": {
        "$pid": {
          ".write": "auth != null",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          }
        }
      },

      "sessions": {
        "$sid": {
          "title":  { ".write": "auth != null", ".validate": "newData.isString() && newData.val().length <= 80" },
          "status": { ".write": "auth != null", ".validate": "newData.isString() && (newData.val() === 'upcoming' || newData.val() === 'done')" },
          "ts":     { ".write": "auth != null" },
          "lineup": { ".write": "auth != null" },
          "result": { ".write": "auth != null" },
          "mvp": {
            "open": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
            "votes": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isString() && newData.val().length <= 40"
              }
            }
          }
        }
      },

      "videos": {
        "$vid": {
          ".write": "auth != null",
          "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "type":  { ".validate": "newData.isString() && (newData.val() === 'link' || newData.val() === 'file')" }
        }
      },

      "saved": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "$vid": { ".validate": "newData.isBoolean()" }
        }
      }
    }
  }
}
