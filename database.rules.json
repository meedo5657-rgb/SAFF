{
  "rules": {
    "portas": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$emp": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'out' || newData.val() === 'stay')"
          }
        }
      },

      "results": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'out' || newData.val() === 'stay')"
        }
      },

      "excluded": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      },

      "section": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      },

      "doubles": {
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },

    "wc2026": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('h').val() <= 30 && newData.child('a').val() >= 0 && newData.child('a').val() <= 30"
          }
        }
      },

      "results": {
        "$mid": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('a').val() >= 0"
        }
      },

      "teams": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "rooms": {
        "$rid": {
          ".write": "auth != null"
        }
      }
    },

    "saff2026": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('h').val() <= 30 && newData.child('a').val() >= 0 && newData.child('a').val() <= 30"
          }
        }
      },

      "results": {
        "$mid": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('a').val() >= 0"
        }
      },

      "teams": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "rooms": {
        "$rid": {
          ".write": "auth != null"
        }
      },

      "polls": {
        "$pid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 4"
          }
        }
      }
    },

    "padel": {
      ".read": "auth != null",

      "players": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          },
          "points":  { ".validate": "newData.isNumber()" },
          "tier":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "w":       { ".validate": "newData.isNumber()" },
          "l":       { ".validate": "newData.isNumber()" },
          "played":  { ".validate": "newData.isNumber()" },
          "active":  { ".validate": "newData.isBoolean()" }
        }
      },

      "matches": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "signups": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.hasChild('name') && newData.hasChild('ts'))"
          }
        }
      },

      "results": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'win' || newData.val() === 'loss'))"
          }
        }
      },

      "teams": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "settings": {
        ".write": "auth != null"
      }
    }
  }
}
