{
  "rules": {
    "portas": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$emp": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'out' || newData.val() === 'stay')"
          }
        }
      },

      "results": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'out' || newData.val() === 'stay')"
        }
      },

      "excluded": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      },

      "section": {
        "$emp": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      },

      "doubles": {
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },

    "wc2026": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('h').val() <= 30 && newData.child('a').val() >= 0 && newData.child('a').val() <= 30"
          }
        }
      },

      "results": {
        "$mid": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('a').val() >= 0"
        }
      },

      "teams": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "rooms": {
        "$rid": {
          ".write": "auth != null"
        }
      }
    },

    "saff2026": {
      ".read": "auth != null",

      "users": {
        "$key": {
          ".write": "auth != null && newData.exists()",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "ph": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          }
        }
      },

      "predictions": {
        "$mid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('h').val() <= 30 && newData.child('a').val() >= 0 && newData.child('a').val() <= 30"
          }
        }
      },

      "results": {
        "$mid": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['h','a']) && newData.child('h').isNumber() && newData.child('a').isNumber() && newData.child('h').val() >= 0 && newData.child('a').val() >= 0"
        }
      },

      "teams": {
        "$mid": {
          ".write": "auth != null"
        }
      },

      "rooms": {
        "$rid": {
          ".write": "auth != null"
        }
      },

      "polls": {
        "$pid": {
          "$key": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 4"
          }
        }
      }
    },

    "volley": {
      ".read": "auth != null",

      "users": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          }
        }
      },

      "players": {
        "$pid": {
          ".write": "auth != null",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "num": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 99)"
          }
        }
      },

      "videos": {
        "$vid": {
          ".write": "auth != null",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "type": {
            ".validate": "newData.isString() && (newData.val() === 'link' || newData.val() === 'file')"
          }
        }
      },

      "saved": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "$vid": {
            ".validate": "newData.isBoolean()"
          }
        }
      },

      "results": {
        "$rid": {
          ".write": "auth != null"
        }
      },

      "lineup": {
        ".write": "auth != null"
      },

      "mvp": {
        "$sid": {
          "title": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "open": {
            ".write": "auth != null",
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".write": "auth != null"
          },
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          }
        }
      }
    }
  }
}
